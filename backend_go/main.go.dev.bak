func register(c *gin.Context) {
	var cred Credential

	if err := c.ShouldBindJSON(&cred); err != nil {
		c.JSON(400, gin.H{"error": "invalid request"})
		return
	}

	// 1. Check if username already exists (doc ID)
	userRef := client.Collection("users").Doc(cred.Username)
	docSnap, err := userRef.Get(ctx)

	if err == nil && docSnap.Exists() {
		c.JSON(409, gin.H{"error": "username already registered"})
		return
	}

	// 2. Optional: also check email uniqueness
	exists := client.Collection("users").
		Where("email", "==", cred.Email).
		Limit(1).
		Documents(ctx)

	if _, err := exists.Next(); err == nil {
		c.JSON(409, gin.H{"error": "email already registered"})
		return
	}

	// 3. Create user with username as document ID
	_, err = userRef.Set(ctx, map[string]interface{}{
		"email":     cred.Email,
		"password":  cred.Password, // ⚠️ hash this in real apps
		"name":      cred.Name,
		"username":  cred.Username,
		"createdAt": time.Now(),
	})

	if err != nil {
		c.JSON(500, gin.H{"error": err.Error()})
		return
	}

	// 4. Return username as userId
	c.JSON(200, gin.H{
		"userId": cred.Username,
	})
}

func login(c *gin.Context) {
	var cred Credential

	if err := c.ShouldBindJSON(&cred); err != nil {
		c.JSON(400, gin.H{"error": "invalid request"})
		return
	}

	iter := client.Collection("users").
		Where("email", "==", cred.Email).
		Where("password", "==", cred.Password).
		Limit(1).
		Documents(ctx)

	doc, err := iter.Next()
	if err != nil {
		c.JSON(401, gin.H{"error": "invalid credentials"})
		return
	}

	c.JSON(200, gin.H{
		"userId": doc.Ref.ID,
	})
}

// ==================== BUDGET HANDLERS ====================

func getBudget(c *gin.Context) {
	userId := c.Param("userId")
	budgetId := c.Param("budgetId")

	doc, err := client.Collection("users").Doc(userId).
		Collection("budgets").Doc(budgetId).Get(ctx)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "Budget not found"})
		return
	}

	var budget Budget
	doc.DataTo(&budget)
	c.JSON(http.StatusOK, budget)
}

func createBudget(c *gin.Context) {
	userId := c.Param("userId")

	var budget Budget
	if err := c.ShouldBindJSON(&budget); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	budget.CreatedAt = time.Now()
	budget.UpdatedAt = time.Now()

	// Calculate daily budget
	// budget.DailyBudget = budget.MonthlyBudget / 30

	budgetId := "budget_" + budget.MonthYear
	_, err := client.Collection("users").Doc(userId).
		Collection("budgets").Doc(budgetId).Set(ctx, budget)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusCreated, gin.H{"budgetId": budgetId, "data": budget})
}

func updateBudget(c *gin.Context) {
	userId := c.Param("userId")
	budgetId := c.Param("budgetId")

	var budget Budget
	if err := c.ShouldBindJSON(&budget); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	budget.UpdatedAt = time.Now()
	// budget.DailyBudget = budget.MonthlyBudget / 30

	_, err := client.Collection("users").Doc(userId).
		Collection("budgets").Doc(budgetId).Set(ctx, budget, firestore.MergeAll)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{"message": "Budget updated", "data": budget})
}

func listBudgets(c *gin.Context) {
	userId := c.Param("userId")

	docs, err := client.Collection("users").Doc(userId).
		Collection("budgets").Documents(ctx).GetAll()
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	budgets := []Budget{}
	for _, doc := range docs {
		var budget Budget
		doc.DataTo(&budget)
		budgets = append(budgets, budget)
	}

	c.JSON(http.StatusOK, budgets)
}

// ==================== EXPENSE HANDLERS ====================

func getExpense(c *gin.Context) {
	userId := c.Param("userId")
	expenseId := c.Param("expenseId")

	doc, err := client.Collection("users").Doc(userId).
		Collection("expenses").Doc(expenseId).Get(ctx)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "Expense not found"})
		return
	}

	var expense Expense
	doc.DataTo(&expense)
	expense.ExpenseID = doc.Ref.ID
	c.JSON(http.StatusOK, expense)
}

func listExpenses(c *gin.Context) {
	userId := c.Param("userId")
	limit := 50 // Default limit

	query := client.Collection("users").Doc(userId).
		Collection("expenses").OrderBy("timestamp", firestore.Desc).Limit(limit)

	docs, err := query.Documents(ctx).GetAll()
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	expenses := []Expense{}
	for _, doc := range docs {
		var expense Expense
		doc.DataTo(&expense)
		expense.ExpenseID = doc.Ref.ID
		expenses = append(expenses, expense)
	}

	c.JSON(http.StatusOK, expenses)
}

func createExpense(c *gin.Context) {
	userId := c.Param("userId")

	var expense Expense
	if err := c.ShouldBindJSON(&expense); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	expense.Timestamp = time.Now()
	expense.CreatedAt = time.Now()
	expense.UpdatedAt = time.Now()

	// Add expense to Firestore
	docRef, _, err := client.Collection("users").Doc(userId).
		Collection("expenses").Add(ctx, expense)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	expense.ExpenseID = docRef.ID

	// Update daily summary
	go updateDailySummaryAfterAdd(userId, expense)

	// Update monthly summary
	go updateMonthlySummaryAfterAdd(userId, expense)

	c.JSON(http.StatusCreated, gin.H{"expenseId": docRef.ID, "data": expense})
}

func updateExpense(c *gin.Context) {
	userId := c.Param("userId")
	expenseId := c.Param("expenseId")

	// Get old expense first for summary updates
	oldDoc, err := client.Collection("users").Doc(userId).
		Collection("expenses").Doc(expenseId).Get(ctx)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "Expense not found"})
		return
	}

	var oldExpense Expense
	oldDoc.DataTo(&oldExpense)

	var newExpense Expense
	if err := c.ShouldBindJSON(&newExpense); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	newExpense.UpdatedAt = time.Now()
	newExpense.CreatedAt = oldExpense.CreatedAt // Keep original creation time

	_, err = client.Collection("users").Doc(userId).
		Collection("expenses").Doc(expenseId).Set(ctx, newExpense)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	// Update summaries (subtract old, add new)
	go updateSummariesAfterUpdate(userId, oldExpense, newExpense)

	c.JSON(http.StatusOK, gin.H{"message": "Expense updated", "data": newExpense})
}

func patchExpense(c *gin.Context) {
	userId := c.Param("userId")
	expenseId := c.Param("expenseId")

	var updates map[string]interface{}
	if err := c.ShouldBindJSON(&updates); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	updates["updatedAt"] = time.Now()

	// Convert map to firestore updates
	var firestoreUpdates []firestore.Update
	for key, value := range updates {
		firestoreUpdates = append(firestoreUpdates, firestore.Update{
			Path:  key,
			Value: value,
		})
	}

	_, err := client.Collection("users").Doc(userId).
		Collection("expenses").Doc(expenseId).Update(ctx, firestoreUpdates)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{"message": "Expense patched"})
}

func deleteExpense(c *gin.Context) {
	userId := c.Param("userId")
	expenseId := c.Param("expenseId")

	// Get expense data before deleting for summary updates
	doc, err := client.Collection("users").Doc(userId).
		Collection("expenses").Doc(expenseId).Get(ctx)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "Expense not found"})
		return
	}

	var expense Expense
	doc.DataTo(&expense)

	// Delete expense
	_, err = client.Collection("users").Doc(userId).
		Collection("expenses").Doc(expenseId).Delete(ctx)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	// Update summaries (subtract deleted expense)
	go updateSummariesAfterDelete(userId, expense)

	c.JSON(http.StatusOK, gin.H{"message": "Expense deleted"})
}

