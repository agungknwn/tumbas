func createCategory(c *gin.Context) {
	userId := c.Param("userId")

	var category Category
	if err := c.ShouldBindJSON(&category); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	category.CreatedAt = time.Now()
	category.IsActive = true

	categoryId := "cat_" + time.Now().Format("20060102150405")
	_, err := client.Collection("users").Doc(userId).
		Collection("categories").Doc(categoryId).Set(ctx, category)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusCreated, gin.H{"categoryId": categoryId, "data": category})
}

func updateCategory(c *gin.Context) {
	userId := c.Param("userId")
	categoryId := c.Param("categoryId")

	var category Category
	if err := c.ShouldBindJSON(&category); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	_, err := client.Collection("users").Doc(userId).
		Collection("categories").Doc(categoryId).Set(ctx, category, firestore.MergeAll)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{"message": "Category updated", "data": category})
}

func deleteCategory(c *gin.Context) {
	userId := c.Param("userId")
	categoryId := c.Param("categoryId")

	_, err := client.Collection("users").Doc(userId).
		Collection("categories").Doc(categoryId).Delete(ctx)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
